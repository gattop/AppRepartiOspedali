# Copia in .env accanto a docker-compose.yml sulla VPS.

# Dominio pubblico (deve puntare alla VPS)
APP_HOST=reparti.example.com

# Immagine pubblicata da GitHub Actions (ghcr.io/<owner>/<repo>, tutto minuscolo)
IMAGE=ghcr.io/owner/apprepartiospedali
TAG=latest

# Traefik
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le

# Gruppi/ruoli Keycloak che possono modificare i dati, separati da virgola.
# Vuoto = tutti gli utenti autenticati.
# Con il provider keycloak-oidc i ruoli di realm arrivano come "role:<nome>"
# e quelli di client come "role:<client-id>:<nome>".
EDITOR_GROUPS=role:reparti-editor

# true solo per provare: al primo avvio carica anche gli ospedali di esempio (finti)
SEED_DEMO=false
