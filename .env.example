# Copia in .env accanto a docker-compose.yml sulla VPS:  cp .env.example .env && chmod 600 .env
# Il file .env NON va nel repo (è nel .gitignore): contiene i segreti.

# Immagine pubblicata da GitHub Actions: ghcr.io/<utente-github-minuscolo>/apprepartiospedali
IMAGE=ghcr.io/owner/apprepartiospedali

# Keycloak > realm vps.homelab > Clients > reparti > Credentials > Client secret
OIDC_CLIENT_SECRET=

# 32 byte casuali, generali con:  openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=

# ---- Facoltativi: i default sono nel docker-compose.yml ----
# TAG=latest                      # oppure sha-xxxxxxx / 1.2.3 per fissare una versione
# APP_HOST=ospedali.kyrie.ee
# OIDC_ISSUER_URL=https://login.gattp.it/realms/vps.homelab
# OIDC_CLIENT_ID=reparti
# EDITOR_GROUPS=role:reparti-editor   # vuoto = tutti gli utenti autenticati possono modificare
# SEED_DEMO=false
# TRAEFIK_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=le
