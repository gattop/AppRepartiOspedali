# Copia in oauth2-proxy.env accanto a docker-compose.yml sulla VPS. Contiene segreti: non committarlo.

# Realm Keycloak (issuer = URL del realm)
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/realms/myrealm

# Client confidenziale creato in Keycloak per questa app
OAUTH2_PROXY_CLIENT_ID=reparti
OAUTH2_PROXY_CLIENT_SECRET=cambiami

# 32 byte casuali. Generalo con:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=cambiami

# Facoltativo: fai entrare solo chi ha questo ruolo di realm (o di client "<client-id>:<ruolo>").
# Lascialo commentato per ammettere tutti gli utenti del realm.
# OAUTH2_PROXY_ALLOWED_ROLES=reparti-user
